<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Android 13+ requires this even for a notification the OS shows on FCM's own behalf, let
         alone one EmberFirebaseMessagingService posts itself for a data-only NEW_PHOTO push. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only needed to save a Memories photo to the gallery on Android 9 and below — scoped
         storage on Android 10+ (API 29+) lets MediaStore.insert write there with no permission
         at all, which is why this is capped at maxSdkVersion 28 rather than requested everywhere. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Android 11+ hides other installed packages from an app by default. Without declaring
         them here, the invite step can neither read their real launcher icons nor resolve a
         share intent aimed at one specifically — resolveActivity just returns null, so every
         "open WhatsApp" style tap would silently fall back to the generic chooser instead. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.instagram.android" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.snapchat.android" />
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".EmberApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/full_backup_content"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Ember"
        android:supportsRtl="true">

        <!-- No LAUNCHER intent-filter here any more — see the two activity-aliases right below,
             which are the only launcher-visible identities now. This keeps MainActivity itself
             untouched by icon switching entirely: every explicit Intent(context,
             MainActivity::class.java) already used throughout the app (notifications, internal
             navigation) resolves and starts this Activity exactly as before regardless of which
             alias is currently enabled, since explicit intents target the component directly and
             never go through intent-filter resolution at all. Nothing here needed to change for
             Emigo Gold's "custom app icon" perk to work — only the two aliases below did. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:importantForAutofill="noExcludeDescendants"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Ember" />

        <!-- The app's default launcher identity, now expressed as an alias rather than on
             MainActivity directly (see its own comment above) — enabled by default so a fresh
             install behaves exactly as before this feature existed. android:icon matches the
             app-level default declared above. -->
        <activity-alias
            android:name=".MainActivityDefaultIcon"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Emigo Gold's "custom app icon" perk (see AppIconScreen) — a second launcher identity
             for the exact same MainActivity, disabled by default. AppIconSwitcher always enables
             exactly one of the two aliases above and disables the other in the same operation;
             MainActivity's own enabled-state is never touched by either (see its own comment).
             android:icon is a placeholder (the real launcher-icon art for this hasn't been
             supplied yet) — swapping it for the real one later needs no code change, just this
             one line. -->
        <activity-alias
            android:name=".MainActivityGoldIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".push.EmberFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.EmberWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ember_widget_info" />
        </receiver>
    </application>

</manifest>
