server:
  port: ${PORT:8080}
  # Behind a hosting proxy (Railway, and any CDN in front of it) every request arrives from the
  # proxy's own address, so `request.getRemoteAddr()` is the *proxy*, identical for every caller.
  # Every rate limit in this app is keyed on that address (see AuthController), which without this
  # collapses them all into one shared global bucket — 20 logins per 15 minutes for the entire user
  # base. Turn this off only if the app is ever exposed directly, with no proxy in front.
  forward-headers-strategy: ${FORWARD_HEADERS_STRATEGY:framework}
  tomcat:
    connection-timeout: 20s
    max-swallow-size: 26MB

spring:
  application:
    name: ember-backend

  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5432/ember}
    username: ${DB_USERNAME:postgres}
    password: ${DB_PASSWORD:changeme}
  # Caching is in-process (Caffeine) — no Redis service to configure. See CacheConfig.
  jpa:
    hibernate:
      ddl-auto: validate
    open-in-view: false
    properties:
      hibernate:
        format_sql: false

  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true

  servlet:
    multipart:
      max-file-size: 25MB
      max-request-size: 25MB

ember:
  jwt:
    # HS256 secret, base64 or plain — must be >= 32 bytes. Override in prod via env var.
    secret: ${JWT_SECRET:change-this-development-only-secret-value-please-0000}
    access-token-ttl-minutes: ${JWT_ACCESS_TTL_MINUTES:10080}
    issuer: ember-backend

  storage:
    r2:
      endpoint: ${R2_ENDPOINT:}
      region: auto
      bucket: ${R2_BUCKET:ember-photos}
      access-key-id: ${R2_ACCESS_KEY_ID:}
      secret-access-key: ${R2_SECRET_ACCESS_KEY:}
      # Public base URL the app/widget can fetch photos from directly (r2.dev subdomain or custom domain).
      public-base-url: ${R2_PUBLIC_BASE_URL:}

  fcm:
    # Path to the Firebase service-account JSON credentials file.
    credentials-path: ${FCM_CREDENTIALS_PATH:}
    # The same JSON supplied inline, for hosts that can only provide environment variables and not
    # files (Railway has no secret-file feature). Wins over the path above when set.
    credentials-json: ${FCM_CREDENTIALS_JSON:}
    enabled: ${FCM_ENABLED:true}

  play-billing:
    package-name: ${PLAY_PACKAGE_NAME:com.emigo.app}
    service-account-credentials-path: ${PLAY_SERVICE_ACCOUNT_CREDENTIALS_PATH:}
    # Inline counterpart, same reasoning as ember.fcm.credentials-json above.
    service-account-credentials-json: ${PLAY_SERVICE_ACCOUNT_CREDENTIALS_JSON:}
    enabled: ${PLAY_BILLING_ENABLED:true}

logging:
  level:
    # INFO, not DEBUG — these fallbacks are what a deployed instance runs with unless the host
    # overrides them. Set EMBER_LOG_LEVEL=DEBUG locally when actually debugging.
    com.ember.backend: ${EMBER_LOG_LEVEL:INFO}
    org.hibernate.SQL: ${SQL_LOG_LEVEL:WARN}
    org.hibernate.orm.jdbc.bind: ${SQL_LOG_LEVEL:WARN}
